! Paths are relative to the directory the model is run from.
! Soil IDs and tile IDs are defined in the CSV files (1-3 each in this example).
&run_config
  soil_parameters_file       = 'config/soil_types.csv'
  tile_parameters_file       = 'config/tile_types.csv'
  cells_file                 = 'config/cells.csv'
  precipitation_file         = 'config/forcing/precipitation.csv'
  net_radiation_file         = 'config/forcing/net_radiation.csv'
  air_temperature_file       = 'config/forcing/air_temperature.csv'
  potential_evaporation_file = 'config/forcing/potential_evaporation.csv'
  run_days                   = 5.0
  time_step_seconds          = 1800.0   ! must divide 3600 s (hourly forcing)
  output_directory           = 'output'
  output_interval_steps      = 1
/
&soil_config
  n_layers             = 10
  top_layer_thickness  = 0.05
  layer_growth_factor  = 1.3
  initial_temperature  = 285.0
/
