! Soil types: 1 sand, 2 loam, 3 clay_loam.   Tile types: 1 broadleaf, 2 grass, 3 bare_soil.
&grid_config
  n_cells = 4
  soil_type_index = 1, 2, 3, 2
  water_table_depth = 2.0, 1.5, 1.0, 3.0
  tile_fractions(1:3, 1) = 0.6, 0.3, 0.1
  tile_fractions(1:3, 2) = 0.2, 0.7, 0.1
  tile_fractions(1:3, 3) = 0.0, 0.5, 0.5
  tile_fractions(1:3, 4) = 0.0, 0.0, 1.0
/
&soil_config
  n_layers = 10
  top_layer_thickness = 0.05
  layer_growth_factor = 1.3
  initial_temperature = 285.0
/
&run_config
  time_step_seconds = 1800.0
  run_days = 5.0
  output_interval_steps = 1
  output_directory = 'output'
/
